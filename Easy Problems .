-->> Matrix Median.
import java.util.*;
class Solution {
    public int matrixMedian(int[][] matrix) {
        int m = matrix.length;
        int n = matrix[0].length;
        // Step 1: Flatten into 1D array
        int[] arr = new int[m * n];
        int idx = 0;
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                arr[idx++] = matrix[i][j];
            }
        }
        // Step 2: Sort the array
        Arrays.sort(arr);
        // Step 3: Return the median
        return arr[(m * n) / 2];
    }
    public static void main(String[] args) {
        Solution sol = new Solution();
        int[][] matrix = {
            {1, 3, 5},
            {2, 6, 9},
            {3, 6, 9}
        };
        System.out.println(sol.matrixMedian(matrix)); // Output: 5
    }
}
